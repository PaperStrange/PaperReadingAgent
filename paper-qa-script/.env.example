# .env.example —— 复制本文件为 .env 并填入真实密钥（.env 已被 git 忽略，不会入库）
#
# 复制方式（PowerShell）：
#   Copy-Item paper-qa-script\.env.example paper-qa-script\.env
#
# 后端 / Streamlit 的启动脚本会自动读取 .env；命令行脚本也会自动加载 .env。

# 模型服务商：deepseek | dashscope | openai（默认 deepseek）
export PAPERQA_PROVIDER=deepseek

# 三个服务商的 Key，按需填写（也可只填通用的 OPENAI_API_KEY）
export DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
# export DASHSCOPE_API_KEY=sk-你的DashScope密钥
# export OPENAI_API_KEY=sk-你的OpenAI密钥

# 可选：Crossref / SemanticScholar（论文元数据检索）
# CROSSREF_API_KEY=your-crossref-key
# SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key
