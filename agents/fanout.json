{
  "version": 2,
  "comment": "Agent fan-out pipelines as adjustable config (dashboard-editable). Two pipelines: planning_pipeline (research before planning, auto-triggered) and sprint_close_pipeline (three-check + lessons). Conditions/order/executors are adjustable; the user watches agent impact on dev progress via the dashboard. workspace-check stays with the main agent (D2).",
  "planning_pipeline": [
    {
      "order": 1,
      "step": "research",
      "role": "tech-research",
      "spec": "tech-research",
      "task": {
        "trigger": "auto-detect: task input contains research-required keywords (see tech-research spec Trigger section) or an explicit research request",
        "inject": "research report is injected into the planning context BEFORE task decomposition"
      },
      "condition": "research_required",
      "executor": "subagent"
    }
  ],
  "sprint_close_pipeline": [
    {
      "order": 1,
      "step": "scope",
      "role": "impact-assessment",
      "spec": "impact-assessment",
      "task": { "change_set": "auto" },
      "condition": "always",
      "executor": "subagent"
    },
    {
      "order": 2,
      "step": "doc-audit",
      "role": "doc-audit",
      "spec": "doc-audit",
      "task": { "target": "working-tree", "scope": "recommended_scope" },
      "condition": "always",
      "executor": "subagent"
    },
    {
      "order": 3,
      "step": "code-review",
      "role": "code-review",
      "spec": "code-review",
      "tasks": [
        { "target": "branch:windows", "scope": "recommended_scope" },
        { "target": "branch:main", "scope": "recommended_scope" }
      ],
      "condition": "code_changed",
      "executor": "subagent"
    },
    {
      "order": 4,
      "step": "lessons",
      "role": "lessons-learned",
      "spec": "lessons-learned",
      "task": { "sprint_doc": "auto" },
      "condition": "sprint_close",
      "executor": "subagent"
    },
    {
      "order": 5,
      "step": "workspace-check",
      "role": "workspace-check",
      "spec": "workspace-check",
      "condition": "always",
      "executor": "main-agent"
    }
  ]
}
