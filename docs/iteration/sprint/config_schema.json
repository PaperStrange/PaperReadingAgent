{
  "version": 1,
  "groups": [
    {
      "key": "llm",
      "label": "LLM",
      "fields": [
        {
          "key": "provider",
          "label": "模型服务商",
          "type": "string",
          "hint": "内置 deepseek/dashscope/openai/openrouter；可自定义（providers.json / PAPERQA_PROVIDERS_JSON），见 /api/providers",
          "impacts": [
            "更换服务商将替换 LLM/向量化/API Base 的默认值"
          ],
          "readonly": false,
          "default": "deepseek"
        },
        {
          "key": "api_key",
          "label": "API Key",
          "type": "password",
          "hint": "留空则读取环境变量 / paper-qa-script/.env",
          "impacts": [],
          "readonly": false
        },
        {
          "key": "api_base",
          "label": "API Base",
          "type": "string",
          "hint": "留空则使用服务商默认端点",
          "impacts": [],
          "readonly": false
        },
        {
          "key": "model",
          "label": "LLM 模型名",
          "type": "string",
          "hint": "显式覆盖 provider 默认；如 provider=openai 时填 gpt-5、gpt-4o-mini",
          "impacts": [],
          "readonly": false,
          "default": "openai/deepseek-v4-flash"
        },
        {
          "key": "vision_model",
          "label": "视觉/增强模型",
          "type": "string",
          "hint": "证据摘要与图片增强用（含图片上下文必须支持视觉）；留空则随 provider 默认",
          "impacts": [],
          "readonly": false
        },
        {
          "key": "temperature",
          "label": "温度",
          "type": "number",
          "hint": "越高越发散（app 默认 0.1，paperqa 框架默认 0.0）",
          "impacts": [],
          "readonly": false,
          "range": [
            0.0,
            1.0
          ],
          "default": 0.1,
          "pydantic_path": [
            "temperature"
          ]
        }
      ]
    },
    {
      "key": "embedding",
      "label": "Embedding",
      "fields": [
        {
          "key": "embedding_model",
          "label": "Embedding 模型",
          "type": "string",
          "hint": "st- 前缀 = HuggingFace 任意 SentenceTransformer 模型（本地下载/远程下载，首次自动拉取，不依赖 provider 的 embedding API）；其它名 = litellm API 向量（需 provider 支持）；litellm- 前缀强制 API",
          "impacts": [
            "切换后需重新下载对应模型并重建索引"
          ],
          "readonly": false,
          "default": "st-multi-qa-MiniLM-L6-cos-v1"
        },
        {
          "key": "embedding_batch_size",
          "label": "Embedding 批大小",
          "type": "integer",
          "hint": "每批向量化条数",
          "impacts": [],
          "readonly": false,
          "range": [
            1,
            64
          ],
          "default": 10
        }
      ]
    },
    {
      "key": "parsing",
      "label": "Parsing",
      "fields": [
        {
          "key": "chunk_chars",
          "label": "分块字符数",
          "type": "integer",
          "hint": "文本分块大小",
          "impacts": [
            "修改后需重建索引才生效"
          ],
          "readonly": false,
          "range": [
            200,
            100000
          ],
          "default": 5000
        },
        {
          "key": "chunk_overlap",
          "label": "分块重叠",
          "type": "integer",
          "hint": "相邻块重叠字符数",
          "impacts": [
            "修改后需重建索引才生效"
          ],
          "readonly": false,
          "range": [
            0,
            10000
          ],
          "default": 250
        },
        {
          "key": "recurse_subdirectories",
          "label": "递归子目录",
          "type": "boolean",
          "hint": "索引时是否递归 paper_directory 下的嵌套文件夹（默认开；支持工作区外绝对路径与 Windows 长路径）",
          "impacts": [
            "修改后需重建索引才生效"
          ],
          "readonly": false,
          "default": true
        },
        {
          "key": "use_doc_details",
          "label": "元数据详情",
          "type": "boolean",
          "hint": "开启后走 Crossref/SemanticScholar 查元数据与撤稿状态（更慢；app 默认关闭，框架默认开启）",
          "impacts": [
            "元数据检索耗时",
            "修改后需重建索引才生效"
          ],
          "readonly": false,
          "default": false,
          "pydantic_path": [
            "parsing",
            "use_doc_details"
          ]
        },
        {
          "key": "multimodal",
          "label": "多模态(图片)处理",
          "type": "enum",
          "hint": "0=仅文本 1=图片+视觉增强(默认) 2=图片不增强；当前由框架默认固定，表单暂不可改",
          "impacts": [
            "图片内容是否参与回答、parse_chunk_embed 耗时（视觉增强最慢）"
          ],
          "readonly": true,
          "options": [
            0,
            1,
            2
          ],
          "default": 1,
          "pydantic_path": [
            "parsing",
            "multimodal"
          ]
        }
      ]
    },
    {
      "key": "agent",
      "label": "Agent",
      "fields": [
        {
          "key": "rebuild_index",
          "label": "提问前重建索引",
          "type": "boolean",
          "hint": "当前 app 固定为 False（提问前不重建；框架默认 True）",
          "impacts": [],
          "readonly": true,
          "default": false,
          "pydantic_path": [
            "agent",
            "rebuild_index"
          ]
        }
      ]
    },
    {
      "key": "answer",
      "label": "Answer",
      "fields": [
        {
          "key": "evidence_k",
          "label": "证据条数 K",
          "type": "integer",
          "hint": "检索证据数量（当前由框架默认生效，表单暂不可改）",
          "impacts": [],
          "readonly": true,
          "range": [
            1,
            50
          ],
          "default": 10,
          "pydantic_path": [
            "answer",
            "evidence_k"
          ]
        },
        {
          "key": "answer_length",
          "label": "答案长度",
          "type": "string",
          "hint": "如 about 200 words（当前由框架默认生效，表单暂不可改）",
          "impacts": [],
          "readonly": true,
          "default": "about 200 words, but can be longer",
          "pydantic_path": [
            "answer",
            "answer_length"
          ]
        }
      ]
    },
    {
      "key": "datasource",
      "label": "数据源",
      "fields": [
        {
          "key": "data_source",
          "label": "数据源模式",
          "type": "enum",
          "hint": "local=本地论文目录（默认）；remote=URL/arXiv/DOI 下载后建索引",
          "impacts": [
            "切换 remote 需联网下载（首次较慢）",
            "修改后需重建索引才生效"
          ],
          "readonly": false,
          "options": [
            "local",
            "remote"
          ],
          "default": "local"
        },
        {
          "key": "source_urls",
          "label": "URL 列表",
          "type": "string_list",
          "hint": "每行一个：PDF/HTML 直链（http/https）",
          "impacts": [
            "需联网"
          ],
          "readonly": false,
          "default": []
        },
        {
          "key": "source_arxiv_ids",
          "label": "arXiv ID 列表",
          "type": "string_list",
          "hint": "每行一个：如 2409.13740（export.arxiv.org 解析，免 key）",
          "impacts": [
            "需联网"
          ],
          "readonly": false,
          "default": []
        },
        {
          "key": "source_dois",
          "label": "DOI 列表",
          "type": "string_list",
          "hint": "每行一个：如 10.xxxx/yyyy（Unpaywall 查开放全文；需设置 UNPAYWALL_EMAIL 环境变量为真实邮箱）",
          "impacts": [
            "需联网",
            "部分论文无 OA 全文会失败"
          ],
          "readonly": false,
          "default": []
        },
        {
          "key": "manifest_file",
          "label": "Manifest 清单",
          "type": "string",
          "hint": "可选：元数据 CSV/JSON（相对论文目录或绝对路径），对索引文件做元数据增强",
          "impacts": [],
          "readonly": false,
          "default": "",
          "pydantic_path": [
            "agent",
            "index",
            "manifest_file"
          ]
        }
      ]
    },
    {
      "key": "index",
      "label": "Index",
      "fields": [
        {
          "key": "paper_directory",
          "label": "论文目录",
          "type": "string",
          "hint": "本地目录（相对后端工作目录）；remote 模式时为下载暂存目录",
          "impacts": [
            "数据源"
          ],
          "readonly": false,
          "default": "data/pdf"
        },
        {
          "key": "index_name",
          "label": "索引名",
          "type": "string",
          "hint": "存于 ~/.pqa/indexes/<name>/；remote 下载目录为 data/remote/<name>/",
          "impacts": [],
          "readonly": false,
          "default": "debug_index"
        }
      ]
    }
  ]
}
