{
  "version": 1,
  "groups": [
    {
      "key": "llm",
      "label": "LLM",
      "fields": [
        {
          "key": "provider",
          "label": "模型服务商",
          "type": "enum",
          "hint": "deepseek/dashscope/openai 三选一",
          "impacts": [
            "更换服务商将替换 LLM/向量化/API Base 的默认值"
          ],
          "readonly": false,
          "options": [
            "deepseek",
            "dashscope",
            "openai"
          ],
          "default": "deepseek"
        },
        {
          "key": "api_key",
          "label": "API Key",
          "type": "password",
          "hint": "留空则读取环境变量 / paper-qa-script/.env",
          "impacts": [],
          "readonly": false
        },
        {
          "key": "api_base",
          "label": "API Base",
          "type": "string",
          "hint": "留空则使用服务商默认端点",
          "impacts": [],
          "readonly": false
        },
        {
          "key": "model",
          "label": "LLM 模型名",
          "type": "string",
          "hint": "如 openai/deepseek-v4-flash、openai/qwen-omni-turbo、gpt-4o-mini",
          "impacts": [],
          "readonly": false,
          "default": "openai/deepseek-v4-flash"
        },
        {
          "key": "temperature",
          "label": "温度",
          "type": "number",
          "hint": "越高越发散（app 默认 0.1，paperqa 框架默认 0.0）",
          "impacts": [],
          "readonly": false,
          "range": [
            0.0,
            1.0
          ],
          "default": 0.1,
          "pydantic_path": [
            "temperature"
          ]
        }
      ]
    },
    {
      "key": "embedding",
      "label": "Embedding",
      "fields": [
        {
          "key": "embedding_model",
          "label": "Embedding 模型",
          "type": "string",
          "hint": "st-* 为本地模型（首次自动下载）；API 向量模型需服务商支持",
          "impacts": [
            "切换后需重新下载对应模型并重建索引"
          ],
          "readonly": false,
          "default": "st-multi-qa-MiniLM-L6-cos-v1"
        },
        {
          "key": "embedding_batch_size",
          "label": "Embedding 批大小",
          "type": "integer",
          "hint": "每批向量化条数",
          "impacts": [],
          "readonly": false,
          "range": [
            1,
            64
          ],
          "default": 10
        }
      ]
    },
    {
      "key": "parsing",
      "label": "Parsing",
      "fields": [
        {
          "key": "chunk_chars",
          "label": "分块字符数",
          "type": "integer",
          "hint": "文本分块大小",
          "impacts": [
            "修改后需重建索引才生效"
          ],
          "readonly": false,
          "range": [
            200,
            100000
          ],
          "default": 5000
        },
        {
          "key": "chunk_overlap",
          "label": "分块重叠",
          "type": "integer",
          "hint": "相邻块重叠字符数",
          "impacts": [
            "修改后需重建索引才生效"
          ],
          "readonly": false,
          "range": [
            0,
            10000
          ],
          "default": 250
        },
        {
          "key": "use_doc_details",
          "label": "元数据详情",
          "type": "boolean",
          "hint": "开启后走 Crossref/SemanticScholar 查元数据与撤稿状态（更慢；app 默认关闭，框架默认开启）",
          "impacts": [
            "元数据检索耗时",
            "修改后需重建索引才生效"
          ],
          "readonly": false,
          "default": false,
          "pydantic_path": [
            "parsing",
            "use_doc_details"
          ]
        },
        {
          "key": "multimodal",
          "label": "多模态(图片)处理",
          "type": "enum",
          "hint": "0=仅文本 1=图片+视觉增强(默认) 2=图片不增强；当前由框架默认固定，表单暂不可改",
          "impacts": [
            "图片内容是否参与回答、parse_chunk_embed 耗时（视觉增强最慢）"
          ],
          "readonly": true,
          "options": [
            0,
            1,
            2
          ],
          "default": 1,
          "pydantic_path": [
            "parsing",
            "multimodal"
          ]
        }
      ]
    },
    {
      "key": "agent",
      "label": "Agent",
      "fields": [
        {
          "key": "rebuild_index",
          "label": "提问前重建索引",
          "type": "boolean",
          "hint": "当前 app 固定为 False（提问前不重建；框架默认 True）",
          "impacts": [],
          "readonly": true,
          "default": false,
          "pydantic_path": [
            "agent",
            "rebuild_index"
          ]
        }
      ]
    },
    {
      "key": "answer",
      "label": "Answer",
      "fields": [
        {
          "key": "evidence_k",
          "label": "证据条数 K",
          "type": "integer",
          "hint": "检索证据数量（当前由框架默认生效，表单暂不可改）",
          "impacts": [],
          "readonly": true,
          "range": [
            1,
            50
          ],
          "default": 10,
          "pydantic_path": [
            "answer",
            "evidence_k"
          ]
        },
        {
          "key": "answer_length",
          "label": "答案长度",
          "type": "string",
          "hint": "如 about 200 words（当前由框架默认生效，表单暂不可改）",
          "impacts": [],
          "readonly": true,
          "default": "about 200 words, but can be longer",
          "pydantic_path": [
            "answer",
            "answer_length"
          ]
        }
      ]
    },
    {
      "key": "index",
      "label": "Index",
      "fields": [
        {
          "key": "paper_directory",
          "label": "论文目录",
          "type": "string",
          "hint": "本地目录（相对后端工作目录）；远程数据源支持见 roadmap",
          "impacts": [
            "数据源"
          ],
          "readonly": false,
          "default": "data/pdf"
        },
        {
          "key": "index_name",
          "label": "索引名",
          "type": "string",
          "hint": "存于 ~/.pqa/indexes/<name>/",
          "impacts": [],
          "readonly": false,
          "default": "debug_index"
        },
        {
          "key": "manifest_file",
          "label": "Manifest 清单",
          "type": "string",
          "hint": "可选：元数据 CSV 路径（当前表单暂未暴露）",
          "impacts": [],
          "readonly": true,
          "default": null,
          "pydantic_path": [
            "agent",
            "index",
            "manifest_file"
          ]
        }
      ]
    }
  ]
}
